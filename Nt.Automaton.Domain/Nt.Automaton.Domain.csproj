<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		
		<Title>Nt.Automaton</Title>
		<RootNamespace>Nt.Automaton</RootNamespace>
		<Description>Utility library for automaton operations</Description>
		<Version>1.2.2</Version>
	  
		<RepositoryUrl>https://github.com/Natvs/Nt.Automaton</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageId>Nt.Automaton</PackageId>
		<PackageVersion>1.2.2</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>automate ; automaton ; states</PackageTags>
		<PackageReleaseNotes>Syntax correction for declaration of transitions</PackageReleaseNotes>

		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
